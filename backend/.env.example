# Copy this file to .env and fill in real values before running the backend.

# --- MySQL connection ---
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kalakosh_db

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
